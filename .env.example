# ══════════════════════════════════════════════════════════
#  SUITWOLF — Variables de entorno requeridas
#  Copiar como .env.local para desarrollo, o agregar en Vercel → Settings → Environment Variables
# ══════════════════════════════════════════════════════════

# ── Auth (NextAuth / Auth.js) ──────────────────────────────
# Generar con: openssl rand -base64 32
AUTH_SECRET=GENERARLO_CON_OPENSSL

# Credenciales del panel interno (solo vos)
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=tu_contraseña_segura

# ── Supabase ───────────────────────────────────────────────
# Obtener en: Supabase → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── GA4 / contacto (ya existentes) ────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
GMAIL_USER=tu@gmail.com
GMAIL_PASS=app_password_de_gmail
NEXT_PUBLIC_GSC_VERIFICATION=
